                CharacterDatabase.DirectExecute("CREATE TRIGGER reject_replace BEFORE UPDATE ON mod_pbc_history FOR EACH ROW BEGIN IF NEW.id=801 THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='test replacement failure'; END IF; END");
                Check(!DB_ReplaceHistoryBatch({{800,"new one"},{801,"new two"}}),"regen accepted partial failure");
                Check(Count("SELECT COUNT(*) FROM mod_pbc_history WHERE message IN ('old one','old two')")==2,"regen partially published");
                CharacterDatabase.DirectExecute("DROP TRIGGER reject_replace");
                Check(DB_ReplaceHistoryBatch({{800,"new one"},{801,"new two"}}),"regen commit failed");
