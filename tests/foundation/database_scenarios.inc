                Check(DB_MigrateCardAdditionsBatch() && Count("SELECT COUNT(*) FROM mod_pbc_character_card_additions")==1,"migration batch unbounded");
                Check(DB_MigrateCardAdditionsBatch() && Count("SELECT COUNT(*) FROM mod_pbc_memories")==259,"migration remainder lost");
                Check(PBC_ReloadMemoryCaches() && g_PBC_Memories.at(1).size()==258,"migrated cache reload failed");
