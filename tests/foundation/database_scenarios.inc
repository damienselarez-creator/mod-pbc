                Check(!DB_MigrateCardAdditionsBatch(),"migration accepted consume failure");
                Check(Count("SELECT COUNT(*) FROM mod_pbc_character_card_additions")==2 && Count("SELECT COUNT(*) FROM mod_pbc_memories")==0,"migration partially committed");
                CharacterDatabase.DirectExecute("DROP TRIGGER reject_source_delete");
                Check(DB_MigrateCardAdditionsBatch(),"migration failed");
                Check(Count("SELECT COUNT(*) FROM mod_pbc_memories WHERE memory_text IN ('Original intact','Second original')")==2,"migration changed original text");
                Check(!DB_MigrateCardAdditionsBatch() && Count("SELECT COUNT(*) FROM mod_pbc_memories")==2,"migration retry duplicated committed rows");
